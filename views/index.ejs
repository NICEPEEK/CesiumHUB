<%- include('header', { title: locals.title }) %>
<div class="row g-4">
    <div class="col-lg-8">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h4 class="fw-semibold mb-0"><%= title %></h4>
            <span class="text-muted small"><%= posts.length %> записей</span>
        </div>
        <% if(posts.length === 0) { %>
            <div class="glass text-center p-5">
                <i class="bi bi-inbox fs-1 text-muted"></i>
                <p class="mt-3 text-muted">Здесь пока пусто</p>
                <a href="/create" class="btn btn-primary-dark mt-2">Создать пост</a>
            </div>
        <% } %>
        <% posts.forEach(post => { %>
        <div class="glass post-card p-4 animate-in">
            <div class="d-flex gap-3">
                <img src="/uploads/<%= post.author?.avatar || 'default.png' %>" class="avatar-md" onerror="this.src='/uploads/default.png'">
                <div class="flex-grow-1">
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <a href="/user/<%= post.username %>" class="fw-semibold text-decoration-none" style="color: var(--text);"><%= post.username %></a>
                        <% if(post.author?.is_verified) { %><i class="bi bi-patch-check-fill text-primary"></i><% } %>
                        <span class="small text-muted"><%= new Date(post.created_at).toLocaleDateString() %></span>
                        <span class="small text-muted ms-auto"><i class="bi bi-eye"></i> <%= post.views || 0 %></span>
                    </div>
                    <h5 class="mt-2"><a href="/post/<%= post.id %>" class="text-decoration-none" style="color: var(--text);"><%= post.title %></a></h5>
                    <p class="text-muted small"><%= post.description.length > 200 ? post.description.slice(0,200)+'…' : post.description %></p>
                    <% if(post.image && post.image !== 'null') { %>
                        <div class="my-2">
                            <% if(post.image.match(/\.(mp4|mov|webm)$/i)) { %>
                                <video controls class="w-100 rounded-3" style="max-height:380px;"><source src="/uploads/<%= post.image %>"></video>
                            <% } else { %>
                                <img src="/uploads/<%= post.image %>" class="w-100 rounded-3" style="max-height:380px; object-fit:contain; cursor:pointer;" onclick="openModal(this.src)">
                            <% } %>
                        </div>
                    <% } %>
                    <div class="d-flex gap-2 mt-3">
                        <form action="/post/<%= post.id %>/react" method="POST">
                            <input type="hidden" name="type" value="like">
                            <button class="reaction-btn <%= post.userReaction === 'like' ? 'active-like' : '' %>"><i class="bi bi-hand-thumbs-up"></i> <%= post.likes || 0 %></button>
                        </form>
                        <form action="/post/<%= post.id %>/react" method="POST">
                            <input type="hidden" name="type" value="dislike">
                            <button class="reaction-btn <%= post.userReaction === 'dislike' ? 'active-dislike' : '' %>"><i class="bi bi-hand-thumbs-down"></i> <%= post.dislikes || 0 %></button>
                        </form>
                        <a href="/post/<%= post.id %>" class="reaction-btn"><i class="bi bi-chat"></i> <%= post.comments?.length || 0 %></a>
                    </div>
                    <div class="mt-3 pt-2 border-top">
                        <% if(post.comments && post.comments.length) { %>
                            <div class="small text-muted"><strong><%= post.comments[0].username %></strong> <%= post.comments[0].text.slice(0,80) %></div>
                        <% } %>
                        <% if(user) { %>
                            <form action="/post/<%= post.id %>/comment" method="POST" class="mt-2 d-flex gap-2">
                                <input type="text" name="text" class="form-control form-control-sm" placeholder="Комментарий..." required>
                                <button class="btn btn-primary-dark btn-sm px-3"><i class="bi bi-send"></i></button>
                            </form>
                        <% } else { %>
                            <div class="small text-center mt-2"><a href="/login" class="text-accent">Войдите</a> чтобы комментировать</div>
                        <% } %>
                    </div>
                </div>
                <div class="dropdown">
                    <button class="btn btn-sm text-muted" data-bs-toggle="dropdown" style="background:none;">⋯</button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <% if(user && (user.username === post.username || user.is_admin)) { %>
                            <li><a class="dropdown-item text-danger" href="#" onclick="deletePost(<%= post.id %>)"><i class="bi bi-trash"></i> Удалить</a></li>
                        <% } %>
                        <% if(user && user.username !== post.username) { %>
                            <li><a class="dropdown-item" href="#" onclick="reportPost(<%= post.id %>)"><i class="bi bi-flag"></i> Жалоба</a></li>
                        <% } %>
                    </ul>
                </div>
            </div>
        </div>
        <% }) %>
    </div>

    <div class="col-lg-4">
        <div class="glass p-4 sticky-top" style="top: 90px;">
            <div class="d-flex align-items-center gap-2 mb-3">
                <i class="bi bi-info-circle-fill text-accent"></i>
                <h5 class="fw-semibold mb-0">О сервере</h5>
            </div>
            <p class="small text-muted">Geometry Dash Cesium — сообщество креаторов. Делитесь уровнями, находите друзей.</p>
            <hr>
            <div class="d-flex align-items-center gap-2 mb-2"><i class="bi bi-people"></i> <span class="small">Пользователи: <strong><%= stats ? stats.totalUsers : '0' %></strong></span></div>
            <div class="d-flex align-items-center gap-2 mb-2"><i class="bi bi-file-post"></i> <span class="small">Постов: <strong><%= stats ? stats.totalPosts : '0' %></strong></span></div>
            <div class="d-flex align-items-center gap-2 mb-3"><i class="bi bi-chat"></i> <span class="small">Комментариев: <strong><%= stats ? stats.totalComments : '0' %></strong></span></div>
            <hr>
            <div class="d-flex align-items-center gap-2 mb-2"><i class="bi bi-trophy"></i> <span class="small fw-semibold">Лидеры</span></div>
            <% if(topUsers && topUsers.length) { %>
                <% topUsers.slice(0,5).forEach(u => { %>
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <a href="/user/<%= u.username %>" class="small text-decoration-none"><%= u.username %></a>
                        <span class="badge bg-primary"><%= u.reputation %></span>
                    </div>
                <% }) %>
            <% } else { %><div class="small text-muted">—</div><% } %>
            <% if(!user) { %>
                <div class="mt-3"><a href="/register" class="btn btn-primary-dark w-100">Присоединиться</a></div>
            <% } else { %>
                <div class="mt-3 pt-2">
                    <div class="d-flex justify-content-between small mb-1"><span>Ваша репутация</span><span class="fw-semibold"><%= user.reputation || 0 %></span></div>
                    <div class="progress"><div class="progress-bar" style="width: <%= Math.min(100, (user.reputation+100)/2) %>%"></div></div>
                </div>
            <% } %>
        </div>
    </div>
</div>
<script>
function deletePost(id) { if(confirm('Удалить пост?')) fetch(`/post/${id}/delete`,{method:'POST'}).then(()=>location.reload()); }
function reportPost(id) { let r=prompt('Причина жалобы:'); if(r) fetch(`/post/${id}/report`,{method:'POST',body:new URLSearchParams({reason:r})}).then(()=>alert('Жалоба отправлена')); }
function openModal(src) { let m=document.createElement('div'); m.style='position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.85);z-index:9999;display:flex;align-items:center;justify-content:center';m.onclick=()=>m.remove();let img=document.createElement('img');img.src=src;img.style='max-width:90%;max-height:90%';m.appendChild(img);document.body.appendChild(m); }
</script>
</body>
</html>
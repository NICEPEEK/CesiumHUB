<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CesiumHUB</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <style>
        :root {
            --bg: #0a0c10;
            --surface: rgba(22, 26, 32, 0.85);
            --text: #eef2ff;
            --text-muted: #9ca3af;
            --border: rgba(255,255,255,0.05);
            --accent: #3b82f6;
            --accent-hover: #2563eb;
        }
        body.light {
            --bg: #f3f4f6;
            --surface: rgba(255,255,255,0.75);
            --text: #111827;
            --text-muted: #4b5563;
            --border: rgba(0,0,0,0.06);
            --accent: #2563eb;
        }
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            background: var(--bg);
            font-family: 'Inter', system-ui, sans-serif;
            color: var(--text);
            transition: all 0.2s;
            padding-top: 90px;
        }
        #fireflyCanvas {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: 0;
        }
        .glass {
            background: var(--surface);
            backdrop-filter: blur(14px);
            border: 1px solid var(--border);
            border-radius: 24px;
        }
        .navbar {
            background: rgba(10,12,16,0.85);
            backdrop-filter: blur(20px);
            border-bottom: 1px solid var(--border);
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            width: 100%;
            z-index: 1000;
            padding: 12px 0;
        }
        body.light .navbar {
            background: rgba(241,245,249,0.85);
        }
        .navbar .container {
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 12px;
        }
        .navbar-brand {
            display: flex;
            align-items: center;
            gap: 8px;
            text-decoration: none;
            font-weight: 700;
            font-size: 1.5rem;
            background: linear-gradient(135deg, var(--accent), #60a5fa);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
        }
        .nav-tabs-custom {
            background: rgba(0,0,0,0.2);
            border-radius: 40px;
            padding: 4px;
            display: flex;
            gap: 4px;
            flex-wrap: wrap;
        }
        .nav-tabs-custom .nav-link {
            border-radius: 40px;
            padding: 8px 20px;
            font-weight: 500;
            font-size: 0.9rem;
            color: var(--text-muted);
            transition: 0.2s;
            text-decoration: none;
            white-space: nowrap;
        }
        .nav-tabs-custom .nav-link i { margin-right: 8px; }
        .nav-tabs-custom .nav-link:hover,
        .nav-tabs-custom .nav-link.active {
            background: var(--accent);
            color: white;
            box-shadow: 0 2px 8px rgba(59,130,246,0.3);
        }
        .navbar-right {
            display: flex;
            align-items: center;
            gap: 12px;
        }
        .btn-icon {
            background: transparent;
            border: none;
            font-size: 1.2rem;
            color: var(--text-muted);
            padding: 6px 10px;
            border-radius: 30px;
            transition: 0.2s;
            cursor: pointer;
        }
        .btn-icon:hover {
            background: rgba(59,130,246,0.2);
            color: var(--accent);
        }
        .btn-primary-dark {
            background: var(--accent);
            border: none;
            border-radius: 32px;
            padding: 6px 18px;
            font-weight: 500;
            font-size: 0.85rem;
            color: white;
            cursor: pointer;
        }
        .btn-outline-dark {
            background: transparent;
            border: 1px solid var(--border);
            border-radius: 32px;
            padding: 6px 18px;
            font-size: 0.85rem;
            color: var(--text-muted);
            text-decoration: none;
            cursor: pointer;
        }
        .btn-outline-dark:hover {
            background: var(--accent);
            color: white;
            border-color: var(--accent);
        }
        .avatar-sm { width: 32px; height: 32px; border-radius: 50%; object-fit: cover; border: 2px solid var(--accent); }
        .avatar-md { width: 48px; height: 48px; border-radius: 50%; object-fit: cover; border: 2px solid var(--accent); }
        .avatar-lg { width: 100px; height: 100px; border-radius: 50%; object-fit: cover; border: 3px solid var(--accent); }
        .post-card { transition: 0.2s; margin-bottom: 24px; }
        .post-card:hover { transform: translateY(-2px); background: rgba(59,130,246,0.08); border-color: var(--accent); }
        .reaction-btn {
            background: rgba(255,255,255,0.05);
            border: none;
            border-radius: 32px;
            padding: 5px 16px;
            font-weight: 500;
            color: var(--text-muted);
            cursor: pointer;
        }
        .reaction-btn:hover { background: var(--accent); color: white; }
        .active-like { background: #10b98120; color: #10b981; border-left: 2px solid #10b981; }
        .active-dislike { background: #f43f5e20; color: #f43f5e; border-left: 2px solid #f43f5e; }
        .form-control {
            background: rgba(0,0,0,0.3);
            border: 1px solid var(--border);
            border-radius: 20px;
            padding: 10px 16px;
            color: var(--text);
        }
        .form-control:focus {
            border-color: var(--accent);
            box-shadow: 0 0 0 3px rgba(59,130,246,0.2);
            outline: none;
        }
        .progress { background: rgba(255,255,255,0.1); border-radius: 10px; height: 5px; }
        .progress-bar { background
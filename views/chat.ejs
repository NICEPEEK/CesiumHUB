<%- include('header', { title: `Чат с ${otherUser.username}` }) %>
<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="glass p-4">
            <div class="d-flex align-items-center gap-3 mb-4">
                <a href="/messages" class="btn btn-outline-dark btn-sm">← Назад</a>
                <img src="/uploads/<%= otherUser.avatar %>" class="avatar-md" onerror="this.src='/uploads/default.png'">
                <h5 class="mb-0"><%= otherUser.username %></h5>
            </div>
            <div class="chat-messages" style="height: 400px; overflow-y: auto; padding: 15px; background: rgba(0,0,0,0.2); border-radius: 20px;">
                <% messages.forEach(msg => { %>
                    <div class="mb-3 <%= msg.from_user_id === user.id ? 'text-end' : 'text-start' %>">
                        <div class="d-inline-block p-3 rounded-3" style="max-width: 75%; background: <%= msg.from_user_id === user.id ? 'var(--accent)' : 'var(--surface)' %>; color: <%= msg.from_user_id === user.id ? 'white' : 'var(--text)' %>;">
                            <%= msg.message %>
                        </div>
                        <div class="small text-muted mt-1"><%= new Date(msg.created_at).toLocaleTimeString() %></div>
                    </div>
                <% }) %>
            </div>
            <form action="/messages/send/<%= otherUser.id %>" method="POST" class="mt-3 d-flex gap-2">
                <input type="text" name="message" class="form-control" placeholder="Сообщение..." autocomplete="off" required>
                <button type="submit" class="btn btn-primary-dark px-4">Отправить</button>
            </form>
        </div>
    </div>
</div>
<script>document.querySelector('.chat-messages').scrollTop = document.querySelector('.chat-messages').scrollHeight;</script>
</body>
</html>
<%- include('header', { title: locals.title }) %>
<div class="row">
    <div class="col-lg-8 mx-auto">
        <div class="glass post-card p-4 animate-in">
            <div class="d-flex gap-3 mb-3">
                <img src="/uploads/<%= post.author?.avatar || 'default.png' %>" class="avatar-md" onerror="this.src='/uploads/default.png'">
                <div>
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <a href="/user/<%= post.username %>" class="fw-semibold text-decoration-none" style="color: var(--text);"><%= post.username %></a>
                        <% if(post.author?.is_verified) { %><i class="bi bi-patch-check-fill text-primary"></i><% } %>
                        <span class="small text-muted"><%= new Date(post.created_at).toLocaleDateString() %></span>
                    </div>
                    <div class="small text-muted"><i class="bi bi-eye"></i> <%= post.views || 0 %> просмотров</div>
                </div>
            </div>
            <h4 class="fw-bold"><%= post.title %></h4>
            <p class="text-muted mt-3"><%= post.description %></p>
            <% if(post.image && post.image !== 'null') { %>
                <div class="my-3">
                    <% if(post.image.match(/\.(mp4|mov|webm)$/i)) { %>
                        <video controls class="w-100 rounded-3"><source src="/uploads/<%= post.image %>"></video>
                    <% } else { %>
                        <img src="/uploads/<%= post.image %>" class="w-100 rounded-3" style="max-height:450px; object-fit:contain;" onclick="openModal(this.src)">
                    <% } %>
                </div>
            <% } %>
            <div class="d-flex gap-2 mt-3">
                <form action="/post/<%= post.id %>/react" method="POST">
                    <input type="hidden" name="type" value="like">
                    <button class="reaction-btn <%= post.userReaction === 'like' ? 'active-like' : '' %>"><i class="bi bi-hand-thumbs-up"></i> <%= post.likes || 0 %></button>
                </form>
                <form action="/post/<%= post.id %>/react" method="POST">
                    <input type="hidden" name="type" value="dislike">
                    <button class="reaction-btn <%= post.userReaction === 'dislike' ? 'active-dislike' : '' %>"><i class="bi bi-hand-thumbs-down"></i> <%= post.dislikes || 0 %></button>
                </form>
            </div>
            
            <hr>
            <h5 class="fw-semibold">Комментарии (<%= post.comments?.length || 0 %>)</h5>
            
            <% if(user) { %>
                <form action="/post/<%= post.id %>/comment" method="POST" class="mt-3 d-flex gap-2">
                    <input type="text" name="text" class="form-control" placeholder="Написать комментарий..." required>
                    <button type="submit" class="btn btn-primary-dark px-4">Отправить</button>
                </form>
            <% } else { %>
                <div class="small text-center mt-3"><a href="/login">Войдите</a>, чтобы оставить комментарий</div>
            <% } %>
            
            <div class="mt-4">
                <% if(post.comments && post.comments.length > 0) { %>
                    <% post.comments.forEach(comment => { %>
                        <div class="mb-3 pb-2 border-bottom">
                            <div class="d-flex align-items-center gap-2">
                                <strong class="text-accent"><%= comment.username %></strong>
                                <span class="small text-muted"><%= new Date(comment.created_at).toLocaleString() %></span>
                            </div>
                            <p class="mb-0 mt-1"><%= comment.text %></p>
                        </div>
                    <% }) %>
                <% } else { %>
                    <div class="text-center text-muted py-3">Нет комментариев. Будьте первым!</div>
                <% } %>
            </div>
        </div>
    </div>
</div>
<script>
function openModal(src) { let m=document.createElement('div'); m.style='position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.85);z-index:9999;display:flex;align-items:center;justify-content:center';m.onclick=()=>m.remove();let img=document.createElement('img');img.src=src;img.style='max-width:90%;max-height:90%';m.appendChild(img);document.body.appendChild(m); }
</script>
</body>
</html>